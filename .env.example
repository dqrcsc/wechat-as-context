# ============================================================================
# 1. LLM API 配置（用于后台自动生成结合知识库的 _note.md 初筛卡与手机微信回执）
# 支持主流模型预设：gemini | deepseek | opencode | openai | openrouter | dashscope | siliconflow | moonshot | zhipu | anthropic | custom
# 若本机已配置 GEMINI_API_KEY / DEEPSEEK_API_KEY / OPENCODE_API_KEY / OPENAI_API_KEY，会自动检测复用！
# ============================================================================
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_FAST_MODEL=gemini-2.5-flash
LLM_PRO_MODEL=gemini-2.5-pro

# ============================================================================
# 1.5 本机 AI Agent CLI 路由链配置（Tier 1 本地子智能体优先级顺序）
# 支持扫描并组合：agy, codex, opencode, claude, gemini, workbuddy 以及自定义 CLI
# ============================================================================
CLI_ROUTING_CHAIN=agy,codex,opencode,claude,workbuddy
CUSTOM_CLI_AGENTS=[]
ALLOW_CODEX_FALLBACK=true

# ============================================================================
# 2. 本地服务与个人知识库路径配置
# （微信通信通过 `bun run src/cli.ts login` 扫码绑定 微信ClawBot [AI]，免填任何微信密钥）
# ============================================================================
PORT=8787
# 发送公众号链接后等待用户追加语音/文字批注的合并窗口（秒），默认 10 秒
ANNOTATION_WAIT_SECONDS=10
# 视觉生图、子智能体深度研究等长任务向微信自动同步进度的间隔（秒），默认 25 秒（设 0 可关闭定时推送）
TASK_HEARTBEAT_SECONDS=25
# 普通网页抓取失败后是否允许把完整 URL（含 query）交给第三方 Jina Reader；默认关闭。
ALLOW_JINA_FALLBACK=false

# 个人知识库根目录（支持三种模式）：
# 1) 无知识库独立模式：填 `VAULT_ROOT=none`（或 `VAULT_ENABLED=false`），文章与闪念将自动保存在本地 `data/archive/` 下，无需外部知识库；
# 2) 通用文件夹模式：指向任意现有 Obsidian / Markdown 文件夹（无需 00_home 等编号目录，自动按需检索 .md）；
# 3) 结构化知识库模式：留空默认使用 `./vault`（或指向含 00_home / AGENTS.md 的第二大脑知识库）。
VAULT_ROOT=./vault
# VAULT_ENABLED=true

# ============================================================================
# 3. 可选：自定义知识库子目录与检索参数（若使用默认结构或通用 Obsidian 库可留空）
# ============================================================================
# VAULT_WECHAT_DIR=01_inputs/articles/wechat
# VAULT_WEB_DIR=01_inputs/articles/web
# VAULT_INBOX_DIR=01_inputs/inbox
# VAULT_PAPERS_DIR=01_inputs/papers
# VAULT_IDEAS_DIR=03_ideas/seeds
# VAULT_NOW_FILE=00_home/now.md
# VAULT_QUEUE_FILE=00_home/queue.md
# VAULT_TOPICS_FILE=00_home/topics.md
# VAULT_SEARCH_DIRS=03_ideas,04_topics,05_outputs/plans
# VAULT_DOMAIN_KEYWORDS=

# ============================================================================
# 4. 可选：多通道消息同步与外部扩展 Webhook（支持飞书 / 钉钉 / 自定义 JSON Webhook）
# ============================================================================
NOTIFY_WEBHOOK_URL=
NOTIFY_ON_EVENTS=article,idea,plan
